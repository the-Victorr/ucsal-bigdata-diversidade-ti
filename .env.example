# Copie para .env e preencha. O .env NÃO vai para o repositório.
# A string vem do painel do Aiven ou de: terraform output -raw service_uri
PGHOST=seu-servico.aivencloud.com
PGPORT=12345
PGDATABASE=diversidade_ti
PGUSER=avnadmin
PGPASSWORD=
PGSSLMODE=require

# Token da API do Aiven, usado só pelo Terraform
TF_VAR_aiven_api_token=
TF_VAR_aiven_project=
