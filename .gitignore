# Ignora tudo por padrão e libera só o que é do projeto.
*

!.gitignore
!.env.example
!README.md

!etl/
!etl/**
!sql/
!sql/**
!terraform/
!terraform/**

# Dashboard da etapa 4 (Next.js). Entra inteiro, menos o que é gerado ou secreto.
!dashboard/
!dashboard/**
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/.vercel/
dashboard/.env.local
dashboard/next-env.d.ts
dashboard/tsconfig.tsbuildinfo

# Em docs/ o repositorio leva so o dicionario de dados.
# As respostas das etapas sao entregues como PDF, na raiz.
!docs/
docs/*
!docs/dicionario/
!docs/dicionario/**
# Prints do dashboard, citados no README.
!docs/imagens/
!docs/imagens/**

# Base tratada: é entregável, vai para o repositório.
!data/
!data/export/
!data/export/**
!data/curated/
!data/curated/**

# Entregáveis em PDF
!Etapa 1 Levantamento de Parâmetros e Tipagem de Dados - v2.pdf
!Etapa 2 Unificacao, Tratamento, Modelagem e Armazenamento.pdf
!Etapa 2 Criterios de Inclusao e Exclusao - v2.pdf
!Etapa 3 Infraestrutura, Seguranca e Documentacao.pdf

# Nunca versionar
.env
__pycache__/
*.pyc
.DS_Store
.venv/
data/raw/
data/processed/
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform.lock.hcl

terraform/terraform.tfvars

acesso-leitura.txt
terraform/.terraform.lock.hcl
dashboard/AGENTS.md
